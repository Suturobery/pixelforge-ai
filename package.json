    "desktop:dev": "cd apps/desktop && npm run dev",
    "mcp:test": "cd mini-services/mcp-server && bun test",
    "mcp:typecheck": "cd mini-services/mcp-server && bun x tsc -p tsconfig.json --noEmit",
    "mcp:dev": "cd mini-services/mcp-server && bun run dev",
    "seed:sample": "bun scripts/seed-sample.ts",
    "bench:open": "bun scripts/bench-open.ts",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:smoke": "bash scripts/smoke-stack.sh"
